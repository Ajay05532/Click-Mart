NODE_ENV=development
PORT=3000

# --- Supabase (Project Settings -> API) ---
# Project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=
# "service_role" / secret key. Server-side ONLY: it bypasses Row Level Security. Never put it in a frontend or in git.
SUPABASE_SERVICE_KEY=
# Image buckets are created by supabase/schema.sql (public, 5 MB, JPG/PNG/WebP):
#   product-images   category-images   banner-images   profile-images

# --- Auth: JWT signing secrets. Each must be at least 16 characters; generate with `openssl rand -hex 32` ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Password pepper: secret mixed into every password hash (openssl rand -hex 32). Back it up: changing it locks everyone out. ---
PASSWORD_PEPPER=

# Login cookie: 'lax' when the shop, admin and API share one site (shop.example.com + api.example.com). 'none' only if they are on different sites.
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Where password-reset email links point (customers go to the shop, staff to the admin)
STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175

# --- Payments: mock (no keys needed) or razorpay ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email (leave all blank to print emails in the server log) ---
# Resend (https://resend.com): create an API key and paste it here. RESEND_API_KEY wins over SMTP_URL.
RESEND_API_KEY=
# Before your domain is verified, keep Resend's test sender. It only delivers to the email address of your
# Resend account. After verifying theclickmart.com, use e.g. "ClickMart <orders@theclickmart.com>".
MAIL_FROM="ClickMart <onboarding@resend.dev>"
# Where customer replies go (the test sender cannot receive mail). A real inbox you read.
MAIL_REPLY_TO=
# Alternative to Resend: any SMTP server, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=

# --- Reply by email for support (optional, both needed). Customers can answer a support email
# and the reply lands in the ticket. Point your mail provider's inbound webhook (Postmark format) at
#   https://<your-api>/api/v1/support/inbound-email?secret=<SUPPORT_INBOUND_SECRET>
# and forward <SUPPORT_INBOUND_EMAIL> to the provider. See backend/README.md.
SUPPORT_INBOUND_EMAIL=
SUPPORT_INBOUND_SECRET=

# --- NimbusPost courier (optional). Key pair from the NimbusPost dashboard -> Settings -> API Keys, with the
# admin role and "Customer data" on. Without it the shop delivers everywhere at the flat fee from Settings.
NIMBUSPOST_API_KEY=
NIMBUSPOST_API_SECRET=
# Signs the tracking webhook (16+ random characters, e.g. `openssl rand -hex 24`). Then press
# Admin -> Settings -> Delivery -> "Connect live tracking" on the live admin. Without it, NimbusPost
# webhooks are refused and order status only changes by hand.
NIMBUSPOST_WEBHOOK_SECRET=
