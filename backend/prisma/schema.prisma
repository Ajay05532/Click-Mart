generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum DiscountType {
  PERCENT
  FLAT
  FREE_SHIPPING
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
}

enum StockReason {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCELLATION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerPlacement {
  HERO
  PROMO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]
  redemptions   CouponRedemption[]
  stockMoves    StockMovement[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  name      String
  phone     String
  line      String
  city      String
  state     String
  pin       String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Top-level categories have parentId = null; subcategories (e.g. W240 under Cashews) point at their parent.
model Category {
  id        String     @id
  name      String
  tagline   String     @default("")
  image     String?
  art       String     @default("mix")
  parentId  String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]  @relation("ProductCategory")
  subProducts Product[] @relation("ProductSubcategory")

  @@index([parentId])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  categoryId    String
  subcategoryId String?
  blurb         String   @default("")
  description   String   @default("")
  highlights    String[]
  nutrition     Json     @default("[]")
  images        String[]
  art           String   @default("mix")
  isActive      Boolean  @default(true)
  isBestseller  Boolean  @default(false)
  featuredSize  String?
  sold          Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category   @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory Category?  @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  variants    ProductVariant[]
  reviews     Review[]
  wishlist    WishlistItem[]
  offers      Offer[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  size        String
  sku         String   @unique
  price       Int
  mrp         Int
  stock       Int      @default(0)
  lowStockAt  Int      @default(10)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  movements   StockMovement[]

  @@unique([productId, size])
}

model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  delta     Int
  reason    StockReason
  note      String?
  orderId   String?
  userId    String?
  balance   Int
  createdAt DateTime    @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  label       String
  type        DiscountType
  value       Int          @default(0)
  minOrder    Int          @default(0)
  maxDiscount Int?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  perUserLimit Int?
  usedCount   Int          @default(0)
  categoryIds String[]
  productIds  String[]
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
}

// Automatic price cuts shown on the storefront (separate from checkout coupons).
model Offer {
  id          String       @id @default(cuid())
  name        String
  badge       String?
  type        DiscountType @default(PERCENT)
  value       Int
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  categoryIds String[]
  productIds  String[]
  createdAt   DateTime     @default(now())
  products    Product[]
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String          @default("")
  image     String?
  link      String          @default("/shop")
  placement BannerPlacement @default(HERO)
  sortOrder Int             @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Order {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  userId        String?
  customerName  String
  email         String
  phone         String
  addressLine   String
  city          String
  state         String
  pin           String
  subtotal      Int
  offerDiscount Int           @default(0)
  discount      Int           @default(0)
  shipping      Int           @default(0)
  total         Int
  couponCode    String?
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod
  carrier       String?
  trackingNumber String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String?
  productId   String?
  name        String
  slug        String?
  image       String?
  art         String?
  size        String
  unitPrice   Int
  mrp         Int
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  amount            Int
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod
  raw               Json?
  createdAt         DateTime      @default(now())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerOrderId])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String?
  name      String
  city      String       @default("India")
  rating    Int
  comment   String
  verified  Boolean      @default(false)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
