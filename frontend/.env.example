# Leave empty in development (Vite proxies /api to the backend on :3000).
# In production set to the public URL of the API, e.g. https://api.example.com
VITE_API_URL=
VITE_ADMIN_URL=http://localhost:5175
# The public address of the storefront, no trailing slash, e.g. https://www.example.com.
# Used for canonical links, the sitemap and social previews. Leave empty to use the address in the browser.
VITE_SITE_URL=
