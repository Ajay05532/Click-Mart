# Used by `vite build` (Vercel production builds). These values are public: they end up in the browser bundle.
# Never put a secret here. A variable set in the Vercel project settings overrides the value in this file.

# The ClickMart API on Render, no trailing slash. The app adds /api/v1 itself.
VITE_API_URL=https://click-mart-sdwh.onrender.com

# The customer storefront. Used for older catalogue photos under /images/ and the Google preview of product pages.
VITE_STOREFRONT_URL=https://theclickmart.com
